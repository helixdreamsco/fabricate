{
  "id": "nameplate-desk",
  "version": 1,
  "name": "Desk Nameplate",
  "category": "desk",
  "description": "A wedge-shaped desk nameplate with raised or engraved text.",
  "thumbnail": "/design-thumbs/nameplate-desk.svg",
  "params": {
    "text": {
      "kind": "text",
      "label": "Name",
      "minLength": 1,
      "maxLength": 20,
      "default": "Alex Smith",
      "pattern": "^[A-Za-z0-9 .,!?&'-]+$"
    },
    "font": {
      "kind": "enum",
      "label": "Font",
      "options": [
        "sans-bold",
        "serif-bold",
        "mono-bold"
      ],
      "default": "serif-bold"
    },
    "mode": {
      "kind": "enum",
      "label": "Style",
      "options": [
        "emboss",
        "deboss"
      ],
      "default": "emboss"
    },
    "widthMm": {
      "kind": "number",
      "label": "Width",
      "min": 100,
      "max": 200,
      "step": 10,
      "default": 150,
      "unit": "mm"
    }
  },
  "constraints": {
    "minTextHeightMm": 8,
    "minStrokeMm": 1.2,
    "reliefDepthMm": 2,
    "maxBBoxMm": [
      200,
      45,
      45
    ]
  }
}