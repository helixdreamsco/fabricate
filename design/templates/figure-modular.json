{
  "id": "figure-modular",
  "version": 1,
  "name": "Character Figure",
  "category": "figure",
  "description": "A chunky character with swappable head and accessory, plus an optional name on the base.",
  "thumbnail": "/design-thumbs/figure-modular.svg",
  "params": {
    "body": {
      "kind": "part",
      "label": "Body",
      "socket": "body",
      "options": [
        "capsule",
        "box",
        "round"
      ],
      "default": "capsule"
    },
    "head": {
      "kind": "part",
      "label": "Head",
      "socket": "head",
      "options": [
        "sphere",
        "cube",
        "cat"
      ],
      "default": "sphere"
    },
    "accessory": {
      "kind": "part",
      "label": "Accessory",
      "socket": "accessory",
      "options": [
        "none",
        "hat",
        "antenna",
        "crown"
      ],
      "default": "none"
    },
    "heightMm": {
      "kind": "number",
      "label": "Height",
      "min": 50,
      "max": 120,
      "step": 5,
      "default": 80,
      "unit": "mm"
    },
    "baseText": {
      "kind": "text",
      "label": "Base text",
      "minLength": 0,
      "maxLength": 10,
      "default": "",
      "pattern": "^[A-Za-z0-9 .,!?&'-]*$"
    },
    "font": {
      "kind": "enum",
      "label": "Font",
      "options": [
        "sans-bold",
        "serif-bold",
        "mono-bold"
      ],
      "default": "sans-bold"
    }
  },
  "constraints": {
    "minTextHeightMm": 5,
    "minStrokeMm": 1.2,
    "reliefDepthMm": 1.2,
    "maxBBoxMm": [
      130,
      130,
      130
    ]
  }
}