{
  "id": "logo-keyring",
  "version": 1,
  "name": "Logo Keyring",
  "category": "merch",
  "audience": "brands",
  "description": "Your logo on a keyring or merch tag. Embossed, debossed or cut clean through.",
  "thumbnail": "/design-thumbs/logo-keyring.png",
  "params": {
    "logo": {
      "kind": "asset",
      "label": "Logo",
      "accept": "svg",
      "areaFraction": 0.45,
      "required": false,
      "default": ""
    },
    "shape": {
      "kind": "enum",
      "label": "Shape",
      "options": [
        "rounded-rect",
        "dog-tag"
      ],
      "default": "rounded-rect"
    },
    "mode": {
      "kind": "enum",
      "label": "Style",
      "options": [
        "emboss",
        "deboss",
        "cut-through"
      ],
      "default": "emboss"
    },
    "text": {
      "kind": "text",
      "label": "Text",
      "minLength": 0,
      "maxLength": 10,
      "default": "",
      "pattern": "^[A-Za-z0-9 .,!?&'-]*$"
    },
    "font": {
      "kind": "enum",
      "label": "Font",
      "options": [
        "sans-bold",
        "serif-bold",
        "mono-bold"
      ],
      "default": "sans-bold"
    },
    "widthMm": {
      "kind": "number",
      "label": "Width",
      "min": 30,
      "max": 60,
      "step": 5,
      "default": 40,
      "unit": "mm"
    },
    "thicknessMm": {
      "kind": "number",
      "label": "Thickness",
      "min": 3,
      "max": 4,
      "step": 0.5,
      "default": 3,
      "unit": "mm"
    }
  },
  "quantity": {
    "min": 1,
    "max": 100,
    "default": 1
  },
  "constraints": {
    "minTextHeightMm": 7,
    "minStrokeMm": 1.0,
    "reliefDepthMm": 1.2,
    "maxBBoxMm": [
      70,
      70,
      10
    ]
  }
}
