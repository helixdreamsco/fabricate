{
  "id": "badge-round",
  "version": 1,
  "name": "Round Badge",
  "category": "badge",
  "description": "A round token with an icon and optional text ring, loop included.",
  "thumbnail": "/design-thumbs/badge-round.svg",
  "params": {
    "icon": {
      "kind": "icon",
      "label": "Icon",
      "default": "star"
    },
    "text": {
      "kind": "text",
      "label": "Text",
      "minLength": 0,
      "maxLength": 10,
      "default": "",
      "pattern": "^[A-Za-z0-9 .,!?&'-]*$"
    },
    "font": {
      "kind": "enum",
      "label": "Font",
      "options": [
        "sans-bold",
        "serif-bold",
        "mono-bold"
      ],
      "default": "sans-bold"
    },
    "mode": {
      "kind": "enum",
      "label": "Style",
      "options": [
        "emboss",
        "deboss"
      ],
      "default": "emboss"
    },
    "diameterMm": {
      "kind": "number",
      "label": "Diameter",
      "min": 40,
      "max": 80,
      "step": 5,
      "default": 55,
      "unit": "mm"
    },
    "thicknessMm": {
      "kind": "number",
      "label": "Thickness",
      "min": 3,
      "max": 6,
      "step": 0.5,
      "default": 4,
      "unit": "mm"
    }
  },
  "constraints": {
    "minTextHeightMm": 6,
    "minStrokeMm": 1.2,
    "reliefDepthMm": 1.5,
    "maxBBoxMm": [
      85,
      85,
      10
    ]
  }
}