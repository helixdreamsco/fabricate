// Prisma schema for Fabricate.
//
// Postgres-backed. Local dev runs against `fabricate_dev` on the user's
// Homebrew Postgres 16. Production points DATABASE_URL at the hosted
// Postgres (Neon / Cloud SQL / Vercel Postgres). No model changes needed
// to swap — both URLs use the postgresql:// scheme.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// NextAuth (PrismaAdapter) standard tables
// ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // bcrypt hash for users who signed up via email/password. Null for
  // users who signed up via Google OAuth — they can later add a password
  // by going through the password-reset flow.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedCommunities Community[]        @relation("CommunityOwner")
  memberships      CommunityMember[]
  messages         CommunityMessage[]

  makerProfile      MakerProfile?
  createdJobs       Job[]                   @relation("JobCreator")
  jobMessages       JobMessage[]            @relation("JobMessageAuthor")
  paymentsAsPayer   Payment[]               @relation("PaymentPayer")
  authoredReviews   Review[]                @relation("ReviewAuthor")
  receivedReviews   Review[]                @relation("ReviewSubject")
  disputesFiled     Dispute[]               @relation("DisputeFiledBy")
  disputeMessages   DisputeMessage[]
  notifications     Notification[]          @relation("NotificationRecipient")
  notificationPrefs NotificationPreference?
  legalConsents     LegalConsent[]

  // Latest accepted version of each legal document. The gate at
  // src/lib/legal.ts compares these against the current TERMS_VERSION /
  // PRIVACY_VERSION constants and forces a re-acceptance trip when below.
  acceptedTermsVersion   Int @default(0)
  acceptedPrivacyVersion Int @default(0)

  // Affiliate referral. `referredByCodeId` is set at most once per user
  // (signup or one-time settings redemption) and is then immutable —
  // enforced at the API layer. `affiliateBonusClaimed` flips true on the
  // first successful payment capture and prevents re-triggering.
  affiliateCodes        AffiliateCode[] @relation("AffiliateCodeOwner")
  referredByCodeId      String?
  referredByCode        AffiliateCode?  @relation("AffiliateCodeRedemption", fields: [referredByCodeId], references: [id])
  affiliateBonusClaimed Boolean         @default(false)

  designJobs DesignJob[] @relation("DesignJobOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * Single token store for email/password auth flows — both email
 * verification (purpose="verify_email") and password reset
 * (purpose="reset_password"). Tokens are 32-byte random hex,
 * single-use (consumed = true after redemption), and time-bounded.
 */
model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  // "verify_email" | "reset_password"
  purpose   String
  expires   DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([purpose, email])
}

// ──────────────────────────────────────────────────────────────
// Fabricate — Communities
// ──────────────────────────────────────────────────────────────

model Community {
  id          String  @id @default(cuid())
  // Short, URL-friendly human identifier. Used for /c/[slug].
  slug        String  @unique
  // Random secret code used for /j/[inviteCode] join links. Can be rotated.
  inviteCode  String  @unique
  name        String
  description String?
  // 0-359, used to render a generated avatar without uploading an image.
  iconHue     Int     @default(210)

  ownerId String
  owner   User   @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Policy
  discountPct      Int     @default(0) // 0..100
  freeMode         Boolean @default(false) // overrides discount → £0
  priorityQueue    Boolean @default(false) // community jobs skip ahead
  memberOnlyMakers Boolean @default(false) // if true, maker affiliations are visible ONLY to members

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  CommunityMember[]
  messages CommunityMessage[]

  @@index([ownerId])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "owner" | "admin" | "member"
  role        String    @default("member")
  joinedAt    DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityMessage {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
}

// ──────────────────────────────────────────────────────────────
// Fabricate — Jobs marketplace
// ──────────────────────────────────────────────────────────────

// Real maker accounts (separate from the static catalogue at lib/catalog.ts).
// Catalogue entries remain for marketing/discovery; bidding + payouts require
// a registered MakerProfile attached to a signed-in User.
model MakerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  bio         String?
  // Mirror of the primary PickupLocation row, kept on the profile for
  // cheap single-postcode reads (job lists, bid panels, JSON-LD city).
  // The full set of pickup points lives in `pickupLocations`.
  postcode    String?
  lat         Float?
  lng         Float?

  // Maker waives the creator's "completion photo" fee. Surfaces as a badge
  // in /market and on the maker's bids. When the creator accepts a bid from
  // such a maker on a photo-required job, the fee is not charged.
  freeCompletionPhoto Boolean @default(false)

  // Stripe Connect (Express). null until onboarded.
  stripeAccountId String?
  stripeOnboarded Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids            JobBid[]
  assignedJobs    Job[]              @relation("JobAssignedMaker")
  prioritizedJobs Job[]              @relation("JobPrioritizedMaker")
  payouts         Payout[]
  bookmarks       MakerJobBookmark[]
  verification    MakerVerification?
  printers        Printer[]
  pickupLocations PickupLocation[]
  subscription    MakerSubscription?
}

// One physical pickup point a maker advertises. Makers can list up to 5
// (e.g. home studio + university workshop) and each renders as its own pin
// on the marketplace map. All locations on a profile share the same User,
// so reviews and reputation are aggregated globally — never per-location.
model PickupLocation {
  id      String       @id @default(cuid())
  makerId String
  maker   MakerProfile @relation(fields: [makerId], references: [id], onDelete: Cascade)

  // Optional human label shown in the maker's edit UI and in pickup
  // selectors ("UCL workshop", "Home studio"). The marketplace map
  // intentionally renders pin tooltips with the maker's display name only,
  // so two pins for one maker are visually identical until clicked.
  label    String?
  postcode String
  // Resolved from postcode via postcodes.io. Stored so we don't re-geocode
  // on every read; nullable when geocoding fails.
  lat      Float?
  lng      Float?
  // Free-text pickup instructions ("ring buzzer #4", "weekdays after 6pm").
  notes    String?
  // Exactly one row per maker should have isPrimary=true. The primary's
  // postcode/lat/lng are mirrored to MakerProfile for cheap single-row reads.
  isPrimary Boolean @default(false)
  // 0-based ordering for the maker's edit UI; lower = shown first.
  ordering Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([makerId, ordering])
  @@index([makerId, isPrimary])
}

/**
 * Per-maker matching configuration: when does the maker want to be
 * alerted about a new OPEN job, and when (if ever) should the platform
 * place a bid on their behalf? Defaults skew toward "alerts on, auto-bid
 * off" — alerting is a passive, non-financial signal so opt-out is
 * reasonable; auto-bidding moves real money so opt-in is mandatory.
 *
 * The same row carries both subscription kinds because they share most
 * of their criteria (distance, material strictness) and they're always
 * configured together on /maker/alerts.
 */
model MakerSubscription {
  id      String       @id @default(cuid())
  makerId String       @unique
  maker   MakerProfile @relation(fields: [makerId], references: [id], onDelete: Cascade)

  // ── Job alerts ───────────────────────────────────────────────────────
  alertsEnabled      Boolean @default(true)
  alertsEmailEnabled Boolean @default(true)
  alertsRadiusKm     Int     @default(25)
  alertsGlobal       Boolean @default(false)
  /// "strict" | "primary_or_alt" | "firehose"
  alertsStrictness   String  @default("primary_or_alt")
  /// "HH:MM" 24h, optional. When both set, alerts inside that window are suppressed (still fire in-app, never email).
  alertsQuietStart   String?
  alertsQuietEnd     String?

  // ── Auto-bid ─────────────────────────────────────────────────────────
  autoBidEnabled            Boolean @default(false)
  autoBidUseAlertsCoverage  Boolean @default(true)
  autoBidRadiusKm           Int     @default(25)
  autoBidGlobal             Boolean @default(false)
  autoBidStrictness         String  @default("primary_or_alt")
  /// "match_listed" | "undercut_pct" | "fixed_offset"
  autoBidStrategy           String  @default("match_listed")
  autoBidUndercutPct        Int     @default(5)
  autoBidFixedOffsetPence   Int     @default(50)
  /// Maker's own per-bid floor in pence. Bid is skipped if the strategy would land below this.
  autoBidMakerFloorPence    Int     @default(500)
  autoBidEtaHours           Int     @default(48)
  autoBidMessage            String?
  autoBidBadgeVisible       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single printer in a maker's setup. Makers can list multiple, each with
// its own model + AMS state + material stock. The lowest `priority` value
// among active printers that can fulfil a job is auto-selected at bid time.
model Printer {
  id      String       @id @default(cuid())
  makerId String
  maker   MakerProfile @relation(fields: [makerId], references: [id], onDelete: Cascade)

  // Maker's own label — often "Bambu Lab P1S" or a nickname like
  // "Workhorse" / "Detail rig".
  displayName  String
  // Catalogue model key (matches PRINTER_MODELS in src/lib/printer-models.ts).
  printerModel String
  hasAMS       Boolean @default(false)
  // JSON-encoded array of MaterialKey strings stocked on this printer.
  materials    String  @default("[]")

  // Lower number = higher priority. The first active printer that matches
  // a job's material + AMS requirements wins auto-selection at bid time.
  priority Int     @default(0)
  // Maker can mark a printer offline temporarily without deleting it.
  active   Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids   JobBid[]
  spools FilamentSpool[]

  @@index([makerId, priority])
  @@index([makerId, active])
}

// A single filament roll loaded on (or available for) a printer. Captures
// the material, brand, and colour the maker can actually deliver — feeds
// the colour-aware bid matching downstream and the inventory view.
model FilamentSpool {
  id        String  @id @default(cuid())
  printerId String
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  // Material key (PLA / PETG / ABS / TPU / ...) — free string so we don't
  // block on adding NYLON / ASA / PC / etc. when a maker has them.
  material String
  // Filament brand, free text (e.g. "Bambu Lab Basic", "Polymaker PolyTerra").
  brand    String?
  // Human colour name the maker uses for the spool.
  colorName String
  // Hex string "#RRGGBB" — what we match creator colour requests against.
  colorHex String

  // IN_STOCK | LOW | EMPTY. Empty stays in the list so swapping a spool
  // back to In stock is one click.
  status String  @default("IN_STOCK")
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([printerId])
}

// Maker's per-job action: SAVED (bookmarked for later) or HIDDEN
// (declined / not interested). Hidden jobs are filtered from the maker's
// market view; saved jobs surface in a dedicated tab.
model MakerJobBookmark {
  id      String       @id @default(cuid())
  makerId String
  maker   MakerProfile @relation(fields: [makerId], references: [id], onDelete: Cascade)
  jobId   String
  job     Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // SAVED | HIDDEN
  status  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([makerId, jobId])
  @@index([makerId, status])
}

model Job {
  id String @id @default(cuid())

  creatorId String
  creator   User   @relation("JobCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  // Configuration snapshot — denormalised so historical jobs don't change as
  // the catalogue evolves.
  fileName         String
  fileUrl          String? // path under /uploads/<id>.<ext> for now (swap to S3 before scale)
  fileSizeBytes    Int     @default(0)
  material         String // MaterialKey from catalog (primary pick)
  // JSON array of additional MaterialKey strings the creator will also
  // accept, in priority order. Maker bid is allowed if their printer
  // stocks `material` OR any of these. Empty = no alternatives.
  materialAlternatives String  @default("[]")
  // Free-text creator notes about specific filament/brand/finish
  // preferences ("Prefer matte; Bambu PLA Basic any colour"). Up to
  // 500 chars. Visible to bidders.
  materialNotes        String?
  // JSON-encoded array of hex strings, one per part for multi-material
  partColors       String  @default("[]")
  // When false (default), the creator doesn't care about colour — the
  // maker prints in any colour they have in stock. When true, partColors
  // is the spec the creator wants and the maker should match.
  colorMatters     Boolean @default(false)
  quality          String  @default("STANDARD")
  infillPct        Int     @default(20)
  quantity         Int     @default(1)
  isMultiMaterial  Boolean @default(false)
  partsCount       Int     @default(1)
  estimatedGrams   Float?
  estimatedMinutes Int?
  notes            String?

  // Pricing in pence to avoid float drift.
  // - quotedPricePence: the creator's listed price (≥ minPricePence).
  // - minPricePence: the auto-estimate total at posting time. Acts as a
  //   creator-side floor (server rejects sub-floor postings).
  // - platformFeePence: the platform's cut snapshot. Acts as a maker-bid
  //   floor — bids ≤ this value would erode platform revenue and are
  //   rejected at /api/jobs/[id]/bids.
  quotedPricePence Int
  minPricePence    Int @default(0)
  platformFeePence Int @default(0)

  // Snapshot of the creator's affiliate-referral state at job creation.
  // True = creator was a referred user with no prior bonus claim, so the
  // service fee was waived in the creator-facing quote. At capture time
  // we use this to decide whether to accrue the maker-side cut to the
  // creator's affiliate. If a concurrent earlier job already claimed
  // the bonus, this snapshot is ignored.
  creatorAffiliateWaiverApplied Boolean @default(false)

  // Gross service fee (£2 + 10% of the printing subtotal, in pence) at
  // the time of job creation, before any waiver. Used at capture time
  // for the maker-referred case: the creator's service fee is redirected
  // to the maker's affiliate. Stored even when the creator waiver fired
  // — it represents the "what the creator-side fee was worth" anchor.
  serviceFeeSnapshotPence Int @default(0)

  // Optional creator add-on: maker must upload a photo of the finished print
  // before the job can be marked ready for pickup. Fee is captured on top of
  // the bid amount at acceptance and forwarded to the maker as a payout
  // bonus (no platform cut on this).
  requireCompletionPhoto    Boolean   @default(false)
  completionPhotoFeePence   Int       @default(0)
  completionPhotoUrl        String?
  completionPhotoUploadedAt DateTime?

  // Test strip — small printable stencil with a unique HD-XXXXXX code engraved,
  // visible to both creator and maker. Used as a verification artifact (maker
  // photographs it next to the finished part to prove "this print was made on
  // a working printer"). Default opt-in at checkout for £3 paid to the maker.
  // testStripFreeRequestedAt is a hook for the slice 2 dispute flow where the
  // creator can request a free reprint after a failed delivery.
  // testStripCode is set on every job. The OTHER three fields gate whether
  // the test strip surfaces in the creator's view: it appears iff the
  // creator paid at checkout, the creator requested one mid-flight (free,
  // typically after a print issue), or the maker preemptively offered one.
  // The maker's view shows the card unconditionally — they always have the
  // option to print a verification stencil.
  testStripCode                 String    @unique
  testStripPaid                 Boolean   @default(true)
  testStripFeePence             Int       @default(0)
  testStripRequestedByCreatorAt DateTime?
  testStripOfferedByMakerAt     DateTime?

  // Pickup happens at the maker's location by default (see MakerProfile.postcode).
  // pickupPostcode is now an optional creator override — only set if they want
  // to suggest a different meet-up point. The QR handshake is location-agnostic
  // so creator and maker can agree elsewhere via chat.
  pickupPostcode String?
  pickupLat      Float?
  pickupLng      Float?
  pickupNotes    String?

  // Optional preferred maker (visible-everywhere, just badge + sort boost)
  prioritizedMakerId String?
  prioritizedMaker   MakerProfile? @relation("JobPrioritizedMaker", fields: [prioritizedMakerId], references: [id])

  // Selected after creator accepts a bid
  assignedMakerId String?
  assignedMaker   MakerProfile? @relation("JobAssignedMaker", fields: [assignedMakerId], references: [id])

  // Status string — one of: OPEN | ASSIGNED | IN_PROGRESS | READY_FOR_PICKUP
  // | PICKED_UP | COMPLETED | CANCELLED | DISPUTED
  status String @default("OPEN")

  // Optional community context (carry forward existing community discount/free
  // mode at quote time). Loose ref — no FK so a deleted community doesn't
  // cascade-delete jobs.
  communityId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Set when status transitions to COMPLETED. Used as the anchor for the
  // 14-day reveal cutoff on mutual reviews.
  completedAt DateTime?

  bids             JobBid[]
  events           JobEvent[]
  messages         JobMessage[]
  pickupTokens     PickupToken[]
  payment          Payment?
  bookmarks        MakerJobBookmark[]
  reviews          Review[]
  disputes         Dispute[]
  affiliateEarnings AffiliateEarning[]

  @@index([status, createdAt])
  @@index([creatorId])
  @@index([assignedMakerId])
  @@index([prioritizedMakerId])
}

model JobBid {
  id      String       @id @default(cuid())
  jobId   String
  job     Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  makerId String
  maker   MakerProfile @relation(fields: [makerId], references: [id], onDelete: Cascade)

  // The printer this bid commits. Null only for legacy / migration-period
  // bids; new bids always carry a printer chosen by selectBestPrinter().
  printerId String?
  printer   Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)

  priceOfferPence Int
  etaHours        Int
  message         String?

  // PENDING | ACCEPTED | DECLINED | WITHDRAWN
  status String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, makerId])
  @@index([jobId, status])
  @@index([makerId])
  @@index([printerId])
}

model JobEvent {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // "system" | "creator" | "maker"
  actor   String
  // userId for non-system events
  actorId String?

  // status_change | log | bid_placed | bid_accepted | pickup_minted
  // pickup_verified | payment_authorized | payment_captured
  // payout_released | payment_refunded | issue_reported
  kind String

  body String
  // optional structured JSON payload
  data String?

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

model JobMessage {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("JobMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // body is allowed to be empty when an image is attached.
  body      String
  // Optional image attachment. Path under /api/uploads/image/<name>; access
  // is gated by membership in the job (see uploads/image/[name]/route.ts).
  imageUrl  String?
  imageMime String?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

model PickupToken {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // 6-digit numeric code, also encoded into the QR payload as
  // fabricate://pickup/<code> so a generic QR scanner shows a recognisable URL.
  code String @unique

  // MAKER_TO_CREATOR (creator shows code; maker scans/types — default)
  // CREATOR_TO_MAKER (reverse fallback when maker has no camera)
  direction String @default("MAKER_TO_CREATOR")

  consumedAt DateTime?
  consumedBy String? // userId

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([jobId])
}

model Payment {
  id      String @id @default(cuid())
  jobId   String @unique
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  payerId String
  payer   User   @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)

  amountPence      Int
  platformFeePence Int @default(0)

  // Stripe references — null in sim mode (we generate sim_pi_… ids).
  stripePaymentIntentId String? @unique
  stripeChargeId        String?

  // PENDING | AUTHORIZED | CAPTURED | REFUNDED | FAILED
  status String @default("PENDING")

  // "live" (real Stripe) | "sim" (in-process simulator)
  mode String @default("sim")

  authorizedAt  DateTime?
  capturedAt    DateTime?
  refundedAt    DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payout    Payout?
  refunds   Refund[]
  taxRecord TaxRecord?
}

model Payout {
  id        String       @id @default(cuid())
  paymentId String       @unique
  payment   Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  makerId   String
  maker     MakerProfile @relation(fields: [makerId], references: [id], onDelete: Cascade)

  amountPence Int

  stripeTransferId String? @unique

  // PENDING | PAID | FAILED
  status String @default("PENDING")
  mode   String @default("sim")

  paidAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([makerId, status])
}

// Mutual reviews between creator and maker after a job hits COMPLETED.
// Reveal-on-both: a review's `revealedAt` is null until either both parties
// have submitted theirs OR 14 days have passed since the job completed (the
// reveal window enforces both submissions, but never blocks reputation
// indefinitely if one party ghosts). Once revealed, public on profile pages
// and aggregated into rating badges.
model Review {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // "creator_to_maker" | "maker_to_creator" — exactly one row per direction
  // per job (DB-enforced via unique constraint below).
  direction String

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  subjectId String
  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt  DateTime  @default(now())
  // Null = still hidden from non-author. Set when the second party submits OR
  // when a lazy-read finds the 14-day window has passed.
  revealedAt DateTime?

  @@unique([jobId, direction])
  @@index([subjectId, revealedAt])
  @@index([jobId])
}

// ──────────────────────────────────────────────────────────────
// Disputes — creator/maker disagreement on a job. Triggers refund flow.
// ──────────────────────────────────────────────────────────────
model Dispute {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  filedById String
  filedBy   User   @relation("DisputeFiledBy", fields: [filedById], references: [id], onDelete: Cascade)

  reason String

  // OPEN | RESOLVED_CREATOR | RESOLVED_MAKER
  status            String    @default("OPEN")
  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolutionNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages DisputeMessage[]

  // Only one OPEN dispute per job at a time. SQLite treats nulls as distinct
  // in unique indexes, so resolved disputes don't block re-opening.
  @@index([jobId, status])
  @@index([status, createdAt])
}

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  evidenceUrl String?
  createdAt   DateTime @default(now())

  @@index([disputeId, createdAt])
}

// ──────────────────────────────────────────────────────────────
// Refunds — partial or full refund records. Driven by dispute resolution.
// ──────────────────────────────────────────────────────────────
model Refund {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amountPence Int
  reason      String?

  // pending | succeeded | failed
  status         String  @default("pending")
  mode           String  @default("sim")
  stripeRefundId String? @unique
  failureReason  String?

  issuedByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

// ──────────────────────────────────────────────────────────────
// Maker verification — KYC + proof of capability. Bid placement gated.
// ──────────────────────────────────────────────────────────────
model MakerVerification {
  id      String       @id @default(cuid())
  makerId String       @unique
  maker   MakerProfile @relation(fields: [makerId], references: [id], onDelete: Cascade)

  // Overall maker-verification status:
  //   not_started        — nothing done
  //   id_verified        — Stripe Identity returned verified, awaiting calibration
  //   pending_review     — calibration uploaded, admin to look
  //   approved           — admin approved calibration; maker can bid
  //   rejected           — admin rejected calibration with a reason
  status String @default("not_started")

  // Stripe Identity (gov ID + selfie liveness; address taken from doc when present).
  // We DON'T store the document image ourselves — Stripe holds it.
  stripeIdentityVerificationId String?   @unique
  stripeIdentityStatus         String? // mirrors Stripe: requires_input | processing | verified | canceled
  stripeIdentityVerifiedAt     DateTime?

  // Calibration print: photo uploaded by the maker, reviewed by admin.
  calibrationPrintUrl String?

  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────
// Notifications — generic in-app + email feed.
// ──────────────────────────────────────────────────────────────
model Notification {
  id          String @id @default(cuid())
  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // bid_placed | bid_accepted | message_received | status_change |
  // pickup_minted | dispute_filed | dispute_resolved | refund_issued |
  // review_submitted | review_revealed | maker_verified
  kind String

  body String
  link String?
  // JSON-encoded data (small, optional)
  data String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientId, readAt, createdAt])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON map: kind → { email: bool, inApp: bool }. Empty = all channels on.
  prefs String @default("{}")

  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────
// Wait-list — marketing capture for gated trials. Currently used by the
// auto-print trial signup on /makers.
// ──────────────────────────────────────────────────────────────
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  kind      String
  createdAt DateTime @default(now())

  @@unique([email, kind])
  @@index([kind, createdAt])
}

// ──────────────────────────────────────────────────────────────
// Tax record — per-payment VAT and income breakdown for HMRC reporting.
// ──────────────────────────────────────────────────────────────
model TaxRecord {
  id        String  @id @default(cuid())
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  grossPence          Int
  platformFeeNetPence Int
  platformFeeVatPence Int
  makerPayoutPence    Int
  vatRate             Float @default(0.20)

  capturedAt DateTime @default(now())

  @@index([capturedAt])
}

// Audit log of legal-document acceptances. Append-only — every consent is a
// new row so we can prove exactly which version of which document a user
// accepted at what time, from what IP, what user-agent. No row is ever
// updated or deleted; the most recent acceptance per (userId, kind) is the
// effective consent.
model LegalConsent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "terms" | "privacy"
  kind    String
  version Int

  ipAddress String?
  userAgent String?

  acceptedAt DateTime @default(now())

  @@index([userId, kind, acceptedAt])
}

// ──────────────────────────────────────────────────────────────
// Affiliate program
// ──────────────────────────────────────────────────────────────
// Anyone can mint one shareable code (e.g. NOFEES-MILES). When a new user
// redeems it (signup or one-time settings entry), their first successful
// paid job triggers a kickback: the referred user's own fee is waived,
// and the *counterparty's* fee — which Fabricate would otherwise keep —
// accrues to the affiliate's balance. Balances ≥ £20 are paid out via
// Stripe Connect Express. Collision (both parties referred, both unclaimed):
// no waivers, both affiliates get a 50p consolation from Fabricate's pocket.

model AffiliateCode {
  id      String @id @default(cuid())
  code    String @unique
  ownerId String
  owner   User   @relation("AffiliateCodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Accumulated in pence. Decremented on payout.
  balancePence        Int @default(0)
  lifetimeEarnedPence Int @default(0)
  paidOutPence        Int @default(0)

  // Stripe Connect Express account that affiliate payouts transfer to.
  // Maker affiliates can reuse their MakerProfile.stripeAccountId
  // (copied on code mint). Non-maker affiliates onboard separately
  // via /api/affiliate/onboard. The flag is denormalised from Stripe
  // and may lag behind their actual account state.
  stripeAccountId  String?
  stripeOnboarded  Boolean @default(false)

  redemptions User[]              @relation("AffiliateCodeRedemption")
  earnings    AffiliateEarning[]
  payouts     AffiliatePayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model AffiliateEarning {
  id     String        @id @default(cuid())
  codeId String
  code   AffiliateCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  amountPence Int

  // "creator_referral" — referred creator's first job; we redirect the
  //                     maker-side platform cut to this affiliate.
  // "maker_referral"   — referred maker's first job; we redirect the
  //                     creator-side service fee to this affiliate.
  // "collision"        — both sides referred + unclaimed; flat 50p
  //                     consolation paid from Fabricate's pocket.
  reason String

  createdAt DateTime @default(now())

  // One earning per code per job — collision case generates two rows
  // (different codes) on the same job, so jobId alone isn't unique.
  @@unique([jobId, codeId])
  @@index([codeId, createdAt])
}

// ──────────────────────────────────────────────────────────────
// Reddit monitor — tracks posts + comments matching our seed
// subreddits/keywords. Sweep at /api/reddit-monitor/sweep dedups
// against this table so the same thread only emails once.
// ──────────────────────────────────────────────────────────────

model RedditMention {
  id String @id @default(cuid())

  // Reddit's full id including prefix: t3_xxxxxx for posts,
  // t1_xxxxxx for comments. Unique constraint = our dedup key.
  redditId String @unique

  // "post" | "comment"
  kind String

  subreddit      String
  authorName     String?
  // For posts: the post title. For comments: the parent post's title
  // so the email digest can group by thread.
  title          String?
  // Truncated body for the email preview. Full body lives on Reddit.
  bodyExcerpt    String?
  url            String
  matchedKeyword String

  postedAt    DateTime
  capturedAt  DateTime  @default(now())
  // Set once the row is included in a sent digest. Lets us re-run
  // sweeps without re-emailing.
  notifiedAt  DateTime?

  @@index([capturedAt])
  @@index([notifiedAt])
}

model AffiliatePayout {
  id     String        @id @default(cuid())
  codeId String
  code   AffiliateCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  amountPence Int

  // PENDING | PAID | FAILED
  status           String  @default("PENDING")
  stripeTransferId String? @unique
  failureReason    String?
  mode             String  @default("sim")

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([codeId, status])
}

// ─── Design customiser (parametric templates + AI text-to-creation) ──────
// A DesignJob is a compute job (generate → repair → validate → slice), not
// a marketplace Job. When ready, its STL hands off to the normal upload →
// configure → quote flow. Guests may run preset jobs (anonId cookie);
// AI jobs require a signed-in user (quota + moderation audit).

model DesignJob {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("DesignJobOwner", fields: [userId], references: [id], onDelete: SetNull)
  /// Guest ownership: signed anonymous cookie id when userId is null.
  anonId String?

  kind            String // "preset" | "ai"
  taskKind        String? // ai: "text" | "image"
  templateId      String?
  templateVersion Int?
  paramsJson      String? @db.Text // canonicalised parameter JSON (presets)
  paramsHash      String // dedupe / cache key
  prompt          String? @db.Text
  shapedPrompt    String? @db.Text
  seed            Int     @default(0)
  provider        String? // "meshy"
  providerTaskId  String?
  stage           String? // "preview" | "refined"
  credits         Int     @default(0)
  progress        Int     @default(0)
  imageKey        String?

  state        String  @default("queued") // queued|moderating|blocked|generating|downloading|processing|ready|failed
  stateHistory Json    @default("[]")
  failReason   String?
  badge        String? // ready | needs_supports | too_fragile
  stlKey       String?
  glbKey       String?
  metricsJson  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([anonId, createdAt])
  @@index([paramsHash, createdAt])
}

model DesignModerationLog {
  id      String  @id @default(cuid())
  userId  String?
  anonId  String?
  prompt  String  @db.Text
  stage   String // "blocklist" | "classifier"
  verdict String // "allow" | "block"
  reason  String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}
