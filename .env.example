# Fabricate environment variables
#
# Copy this file to `.env.local` for local dev. Production deploys set these
# as platform env vars (Vercel: Settings → Environment Variables; Cloud Run:
# `gcloud run deploy --set-env-vars=...`; Fly: `fly secrets set ...`).
#
# Variables marked REQUIRED IN PROD must be set before flipping the
# pre-launch banner off. OPTIONAL ones have safe defaults; without them the
# corresponding feature degrades gracefully (see comments).

# ─── Core app ────────────────────────────────────────────────────────────

# REQUIRED IN PROD. Public origin of the app — used in emails, OAuth
# return URLs, OG metadata. Do NOT include a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REQUIRED IN PROD. Same value as NEXT_PUBLIC_APP_URL — read by server-side
# code that doesn't have access to NEXT_PUBLIC_ prefixed vars.
APP_URL=http://localhost:3000

# REQUIRED IN PROD. NextAuth checks the Host header against this value. If
# unset NextAuth refuses requests with "UntrustedHost". Set to "true" to
# trust whatever Host the deploy platform forwards (Vercel sets this
# automatically; manual hosts may need it explicit).
AUTH_TRUST_HOST=true

# REQUIRED IN PROD. NextAuth needs a strong secret to sign JWTs. Generate
# with `openssl rand -base64 32`. Different per environment; rotating
# invalidates all sessions (everyone has to sign in again).
AUTH_SECRET=

# ─── Database ────────────────────────────────────────────────────────────

# REQUIRED. Postgres connection string. Local dev points at Homebrew
# Postgres; production points at Neon / Cloud SQL / Vercel Postgres.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://localhost:5432/fabricate_dev?schema=public

# ─── Authentication ──────────────────────────────────────────────────────

# REQUIRED. Google OAuth credentials from Google Cloud Console.
# Create the OAuth 2.0 Web app client at console.cloud.google.com →
# APIs & Services → Credentials. Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google  (dev)
#   https://YOUR-DOMAIN/api/auth/callback/google    (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Stripe ──────────────────────────────────────────────────────────────

# REQUIRED IN PROD. Without these the app falls back to deterministic in-
# process simulation (`paymentMode() === "sim"`).
# - Test keys (sk_test_…, pk_test_…) for dev: dashboard.stripe.com/test/apikeys
# - Live keys (sk_live_…, pk_live_…) for prod: dashboard.stripe.com/apikeys
# Same keys also drive Stripe Identity verification.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# REQUIRED IN PROD. Stripe Identity webhook signing secret (whsec_…).
# - Test mode: from `stripe listen` CLI output
# - Live mode: from dashboard webhook endpoint config (Settings → Webhooks)
# Without this set, the Identity webhook rejects all calls.
STRIPE_IDENTITY_WEBHOOK_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────

# OPTIONAL but strongly recommended. Without RESEND_API_KEY all email
# notifications silently no-op (in-app notifications still work).
# Get key from resend.com → API Keys.
RESEND_API_KEY=

# OPTIONAL. Display name + sender for outgoing emails. Pre-launch defaults
# to onboarding@resend.dev (only delivers to your verified Resend email).
# At launch, switch to a verified-domain sender like
# `Fabricate <hello@fabricate.tld>`.
RESEND_FROM="Fabricate <onboarding@resend.dev>"
EMAIL_FROM="Fabricate <onboarding@resend.dev>"

# ─── Storage ─────────────────────────────────────────────────────────────

# OPTIONAL. Where uploaded mesh files + images are persisted. Defaults to
# <project>/prisma/ which is fine for local dev and any host with a
# persistent filesystem.
# - Vercel: filesystem is EPHEMERAL — uploads vanish on every deploy. You
#   need to swap to S3-compatible storage; the abstraction at
#   src/lib/storage.ts will need a new driver.
# - Cloud Run: mount a Cloud Storage bucket via `--add-volume` and point
#   DATA_DIR at the mount path.
# - Fly.io / VPS: provision a persistent volume, set DATA_DIR=/data.
DATA_DIR=

# ─── Python slicer service (optional, separate process) ──────────────────

# OPTIONAL. Where the FastAPI slicing service lives. Defaults to localhost
# for dev. In prod, point at the deployed FastAPI URL (or skip entirely if
# you're not running server-side slicing yet).
API_HOST=http://127.0.0.1:8000

# ─── Pre-launch staging gate ─────────────────────────────────────────────

# OPTIONAL. When set, every request requires the `fbg_access` cookie set to
# "1" — visitors hit /access first and enter this code. Use to keep
# staging environments private. Leave unset in production.
STAGING_ACCESS_CODE=

# ─── Affiliate payout sweep ──────────────────────────────────────────────

# Bearer secret required by POST /api/affiliate/payouts/sweep. Set this
# AND configure a daily cron (Cloud Scheduler, GitHub Actions, etc.) that
# hits the endpoint with `Authorization: Bearer <secret>`. Without this
# env var the endpoint returns 503 — earnings still accrue, payouts just
# don't transfer until you wire the cron.
AFFILIATE_PAYOUT_SECRET=

# ─── Reddit monitor ──────────────────────────────────────────────────────

# Bearer secret required by POST /api/reddit-monitor/sweep — the cron
# endpoint that polls subreddits and emails a digest. Without this set
# the endpoint returns 503.
REDDIT_MONITOR_SECRET=

# Where digest emails land. Usually your own inbox.
REDDIT_MONITOR_ALERT_EMAIL=

# Reddit's TOS requires a distinctive User-Agent. Pick anything that
# identifies your tool + a contact URL. Default works but you should
# customise to reduce 429 risk.
REDDIT_USER_AGENT="fabricate-reddit-monitor/0.1 (by /u/yourhandle)"

# OPTIONAL — only set these if Reddit starts rate-limiting the
# unauthenticated path (you'll see 429s in the sweep response).
# Without them the monitor uses public JSON endpoints, which work fine
# at our cadence. With them, it switches to OAuth (higher limit).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# ─── Design customiser (/design) ─────────────────────────────────────────

# OPTIONAL. AI text/image-to-creation needs BOTH keys below; missing either
# renders the AI tab as "coming soon" (templates still work). See
# docs/design-customiser.md.
MESHY_API_KEY=
# Moderation stage 2 (fails closed — required for the AI path).
ANTHROPIC_API_KEY=
# Enable Meshy's paid texture stage (texture-only; off by default for FDM).
MESHY_ENABLE_REFINE=
